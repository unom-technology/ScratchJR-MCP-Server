# Copied to .env by `npm run setup` when there is none. Edit .env, not this file.

# Where the projects live. Relative to prisma/schema.prisma.
DATABASE_URL="file:../data/scratchjr-web.db"

# Port 80 lets students type just the address, e.g. http://192.168.9.1
# Use 8080 if something else on this PC already has port 80.
PORT=80

# 0.0.0.0 accepts connections from the classroom network. 127.0.0.1 would
# only allow this PC.
HOST=0.0.0.0

# How long a login lasts. Shared classroom PCs: keep it to about a school day,
# so a student who forgets to log out does not leave their account open.
SESSION_HOURS=12

# Optional HTTPS. The microphone and camera only work in the browser over
# HTTPS (or on this PC itself). Point both at PEM files, e.g. made with mkcert.
# HTTPS_CERT=certs/server.pem
# HTTPS_KEY=certs/server-key.pem
